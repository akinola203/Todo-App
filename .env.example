# ===================================================================
# TaskFlow Environment Variables Configuration Template
# Copy this file to .env and configure your secret credentials.
# ===================================================================

# 1. Django Core Settings
SECRET_KEY=django-insecure-change-this-to-a-secure-random-key-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com,.railway.app

# 2. Database & Cache
# Leave DATABASE_URL commented or empty to default to local SQLite (db.sqlite3)
# DATABASE_URL=postgresql://taskflow_user:password@localhost:5432/taskflow_db
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0

# 3. Google Gemini Generative AI (Nova Copilot)
# Obtain an API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your-gemini-api-key-here

# 4. WebPush VAPID Notifications
# Generate a VAPID keypair via `vapid --gen` or python-webpush
VAPID_PUBLIC_KEY=your-vapid-public-key-here
VAPID_PRIVATE_KEY=your-vapid-private-key-here
VAPID_ADMIN_EMAIL=mailto:admin@taskflow.app

# 5. Email / SMTP Gateway (Optional for dev, required for email reminders)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@taskflow.app

